# Firebase web config for the `nightride-a9173` project — the same project the
# Flutter app connects to (Nightride/lib/firebase_options.dart).
#
# These are NOT secrets: Firebase web config ships to every browser by design,
# and access is enforced by firestore.rules. Copy this file to `.env.local`.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDIN1rVjMgw6r80hYuTRrpSpsV8BH0WEn0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nightride-a9173.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nightride-a9173
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nightride-a9173.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=218660887469
NEXT_PUBLIC_FIREBASE_APP_ID=1:218660887469:web:f58ff04ccc90108522df24

# Google Maps JS API key — powers the organizer application's venue location
# picker (lib/organizer/google-maps.ts). Same Google Cloud project as the
# Flutter app's GOOGLE_MAPS_API_KEY; enable "Maps JavaScript API" and restrict
# the key by HTTP referrer (localhost + the Netlify domain). Also not a secret:
# a static export ships it to the browser, referrer restriction is the control.
# Leave it unset and the picker degrades to "Use my current location" only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Uncomment to talk to the local Firebase emulator suite (see root LOCAL_DEV.md)
# instead of real nightride-a9173. Off by default — leave commented out here.
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
